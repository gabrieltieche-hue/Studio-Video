# Local-only configuration. Never commit real secret values.
PORT=3000
NODE_ENV=development
STORAGE_DIR=./storage
MAX_VIDEO_UPLOAD_BYTES=262144000

# whisper.cpp. Production Docker image configures these paths automatically.
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.bin

# Required for public production deployment. Put the value in Google Secret Manager,
# then expose it to Cloud Run as STUDIO_API_KEY. Never put a real value in Git or chat.
STUDIO_API_KEY=

# Optional comma-separated browser origins allowed by production CORS.
ALLOWED_ORIGINS=
